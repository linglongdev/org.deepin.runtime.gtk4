# runtime 需要的包（这些包及其依赖会被拷进 /runtime）。
#
# 这些包在 linglong.yaml 的 buildext.apt.build_depends 里也列了一遍：
# apt 只会把包装到构建容器的 /usr 下，runtime 的内容由 build.bash 从这里拷出来。
# 改这里时记得同步 linglong.yaml（arm64 那份也要同步）。
#
# 普通条目：由 apt 从源仓库安装（构建容器 /usr 下）
libgtk-4-1
libgtk-4-common
libgtk-4-dev
libgtk-4-media-gstreamer
libgtk-3-0
libgtk-3-bin
libgtk-3-common
libgtk-3-dev
libadwaita-1-0
libadwaita-1-dev
libavif16
libavif-dev
# @ 开头的条目：本仓库自己编译产生（webkit2gtk 4.1），文件直接从 deb 里取
@libwebkit2gtk-4.1-0
@libwebkit2gtk-4.1-dev
@libjavascriptcoregtk-4.1-0
@libjavascriptcoregtk-4.1-dev
@gir1.2-webkit2-4.1
@gir1.2-javascriptcoregtk-4.1
@webkit2gtk-driver
